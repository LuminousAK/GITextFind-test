{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:data && npm run release:prepare -- --local",
    "build:data": "node --env-file=.env.pagefind.local scripts/build_index.js",
    "build:index": "node --env-file=.env.pagefind.local scripts/build_index.js",
    "build:punct-demo": "node --env-file=.env.pagefind.local build_punct_demo.js",
    "demo": "node serve.js",
    "test": "node --test tests/*.test.js",
    "release:prepare": "node --env-file=.env.pagefind.local scripts/prepare_release.js"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
